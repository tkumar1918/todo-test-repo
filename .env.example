# Run a receiver first, then this app:
#   node ../crash-heal-nodesdk/demo/receiver.js   # in one shell — stand-in ingest API on :9000
#   cp .env.example .env && npm start             # in another
CRASH_HEAL_WEBHOOK_URL=http://localhost:9000/api/v1/errors/ingest
CRASH_HEAL_API_KEY=demo-project.demo-secret
CRASH_HEAL_SERVICE_NAME=nodejs-target-repo
CRASH_HEAL_ENVIRONMENT=development
# repoName/repoOwner are parsed from this GitHub URL — set CRASH_HEAL_REPO_NAME/REPO_OWNER
# instead if your remote isn't GitHub.
CRASH_HEAL_REPOSITORY=https://github.com/tkumar1918/nodejs-target-repo
CRASH_HEAL_COMMIT=
CRASH_HEAL_BRANCH=main
CRASH_HEAL_DEDUP_COOLDOWN_MS=10000
CRASH_HEAL_SPOOL_DIR=./.crash-heal-spool
PORT=3000
